{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emersia",
  "version": "0.0.1",
  "identifier": "org.emersia.companion",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Emersia",
        "width": 560,
        "height": 720,
        "minWidth": 420,
        "minHeight": 520,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
