pkgbase = emersia-git
	pkgdesc = Free VR workspace for Meta Quest: stream Linux Wayland desktops as virtual monitors
	pkgver = r0.0000000
	pkgrel = 1
	url = https://github.com/nicklin11/emersia
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = cargo
	makedepends = webkit2gtk-4.1
	makedepends = libayatana-appindicator
	options = !lto
	source = emersia::git+https://github.com/nicklin11/emersia.git
	sha256sums = SKIP

pkgname = emersia-git
	pkgdesc = Free VR workspace for Meta Quest: stream Linux Wayland desktops as virtual monitors (host daemon and CLI)
	depends = ffmpeg
	depends = gcc-libs
	depends = glibc
	optdepends = libva-mesa-driver: AMD/Intel hardware encoding
	optdepends = libnotify: desktop notification when a headset connects
	optdepends = emersia-gui-git: tray sharing indicator and pairing UI
	provides = emersia
	conflicts = emersia

pkgname = emersia-gui-git
	pkgdesc = Free VR workspace for Meta Quest: stream Linux Wayland desktops as virtual monitors (companion app: tray sharing indicator, pairing)
	depends = emersia
	depends = webkit2gtk-4.1
	depends = libayatana-appindicator
	depends = gtk3
	provides = emersia-gui
	conflicts = emersia-gui
