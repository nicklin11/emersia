<?xml version="1.0" encoding="utf-8"?>
<!-- Emersia Quest client (M2.2): a 2D panel that mirrors one host output.
     Horizon OS shows a plain Activity as a floating, resizable window, which is
     all screen mirroring needs; the immersive OpenXR layer comes later. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.emersia.client"
    android:versionCode="1"
    android:versionName="0.0.1">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="32" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Keeps Wi-Fi in its low-latency mode while streaming. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Receiving the PC's pairing beacon (UDP broadcast) while pairing. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-feature android:name="android.hardware.vr.headtracking" android:required="false" />

    <!-- OpenXR (Khronos loader): talk to the runtime broker. -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <!-- debuggable: `run-as` lets scripts/quest-mirror.sh read the public key
         for pairing. Release builds will drop it (M8). -->
    <application
        android:label="Emersia"
        android:debuggable="true"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Black.NoTitleBar">
            <!-- Default panel size on Horizon OS: 16:9 to match the desktop. -->
            <layout android:defaultWidth="1600dp" android:defaultHeight="900dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|quest3|quest3s|questpro" />

        <!-- Immersive mode (ADR 0009): an OpenXR app; Horizon OS switches to it
             in place of the home environment. -->
        <activity
            android:name=".ImmersiveActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:excludeFromRecents="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>

        <!-- One panel per extra stream (another captured output). Launched by
             MainActivity with NEW_TASK|MULTIPLE_TASK, so each is its own
             Horizon OS window. -->
        <activity
            android:name=".PanelActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Black.NoTitleBar">
            <layout android:defaultWidth="1600dp" android:defaultHeight="900dp" />
        </activity>
    </application>
</manifest>
